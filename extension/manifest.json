{
  "manifest_version": 3,
  "name": "Kits Editor for Firefox",
  "version": "0.2.1",
  "description": "Hide Firefox's tab bar and toolbar until you need them. Tabs on any edge, an auto-hiding toolbar, and control over size, color, animation and the address bar.",
  "author": "Matthew Saunders and Austin Laubach",
  "homepage_url": "https://github.com/mattsaund/kits-firefox-plugin",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "nativeMessaging", "alarms"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Kits Editor for Firefox settings",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autohide-tab-bar@kits",
      "strict_min_version": "155.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
