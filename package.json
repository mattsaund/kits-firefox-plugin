{
  "name": "kits-firefox-plugin",
  "version": "0.3.2",
  "private": true,
  "description": "Firefox extension: an auto-hiding tab bar on any edge of the window.",
  "license": "MIT",
  "author": "Matthew Saunders",
  "contributors": [
    "Austin Laubach (https://github.com/cli-geek)"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/*.test.mjs' && python3 -m unittest discover -s tests -p 'test_*.py'",
    "lint": "web-ext lint --source-dir extension --self-hosted",
    "start": "web-ext run --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "sign": "web-ext sign --source-dir extension --artifacts-dir dist --channel unlisted"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
